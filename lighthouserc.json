{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://127.0.0.1:3000/en",
        "http://127.0.0.1:3000/es",
        "http://127.0.0.1:3000/en/projects/maderable",
        "http://127.0.0.1:3000/es/notes/following-a-request-across-kafka"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 412,
          "height": 823,
          "deviceScaleFactor": 1.75
        }
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ],
            "resource-summary:font:size": [
              "error",
              {
                "maxNumericValue": 71680
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "/(en|es)$",
          "assertions": {
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 153600
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "/(projects|notes)/",
          "assertions": {
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 168960
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
